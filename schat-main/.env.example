NODE_ENV=development
PORT=3000
HTTP_HOST=127.0.0.1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas yoki lokal MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hallaym_edu
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=30
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Kamida 32 ta tasodifiy belgi. Productionda placeholder qabul qilinmaydi.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

UNIVERSITY_NAME=Qarshi davlat texnika universiteti
DATA_CONTROLLER_NAME=Universitet nomi
DATA_CONTROLLER_EMAIL=privacy@university.uz
DATA_RETENTION_DAYS=365
ALLOW_PUBLIC_REGISTRATION=true

# mediasoup SFU
MEDIASOUP_ENABLED=1
MEDIASOUP_LISTEN_IP=0.0.0.0
# Lokal: 127.0.0.1. Production: serverning public IPv4 yoki direct DNS nomi.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_LOG_LEVEL=warn
MEDIASOUP_WORKERS=4
MEDIASOUP_MAX_PEERS_PER_ROOM=250
MEDIASOUP_INITIAL_OUTGOING_BITRATE=1500000
MEDIASOUP_MAX_INCOMING_BITRATE=2500000

# TURN: static username/password yoki shared secret variantidan birini tanlang.
TURN_URLS=turn:turn.example.uz:3478?transport=udp,turn:turn.example.uz:3478?transport=tcp,turns:turn.example.uz:5349?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
TURN_TTL_SECONDS=86400
TURN_FORCE_RELAY=0

# Eski ExpressTURN nomlari ham qo‘llanadi.
EXPRESS_TURN_URLS=
EXPRESS_TURN_USERNAME=
EXPRESS_TURN_CREDENTIAL=
EXPRESS_TURN_SECRET=
EXPRESS_TURN_TTL_SECONDS=86400
# ExpressTURN dashboardidagi nomlar ham to‘g‘ridan-to‘g‘ri qo‘llanadi.
EXPRESSTURN_HOST=relay1.expressturn.com
EXPRESSTURN_USERNAME=
EXPRESSTURN_PASSWORD=
EXPRESSTURN_SECRET_KEY=
EXPRESSTURN_TTL=86400

# Production uchun r2 tavsiya qilinadi; local disk doimiy bo‘lmasligi mumkin.
STORAGE_DRIVER=local
MAX_UPLOAD_MB=250
UPLOAD_TMP_DIR=/tmp/hallaym-edu-uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hallaym-edu
R2_PUBLIC_BASE_URL=
# 1 GB+ videodarslar uchun 8 MB multipart, 5 GB limit.
COURSE_VIDEO_MAX_GB=5
COURSE_VIDEO_PART_MB=8
COURSE_VIDEO_UPLOAD_TTL_SECONDS=86400

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SCHEDULE_UTC_OFFSET_MINUTES=300

# Faqat birinchi ishga tushirishda. Admin yaratilgach PASSWORD ni olib tashlang.
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# To‘lov rekvizitlari
PREMIUM_PAYMENT_HOLDER=HALLAYM ADMIN
PREMIUM_PAYMENT_CARD=8600 0000 0000 0000
PREMIUM_PAYMENT_BANK_NOTE=To'lovdan keyin screenshot yuklang va admin tasdig'ini kuting.
