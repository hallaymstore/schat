{
  "name": "university-chat-platform",
  "version": "4.0.0",
  "description": "Real-time social chat platform for university students",
  "main": "server115007.js",
  "scripts": {
    "start": "node server115007.js",
    "dev": "nodemon server115007.js",
    "test": "node --test tests/*.test.js",
    "build:mediasoup-client": "esbuild public/vendor/mediasoup-client.entry.js --bundle --format=iife --platform=browser --global-name=SchatMediasoupBundle --outfile=public/vendor/mediasoup-client.bundle.js --minify",
    "build:realtime:css": "tailwindcss -c tailwind.realtime.config.cjs -i ./src/styles/realtime-tailwind.css -o ./public/vendor/tailwind-realtime.css --minify",
    "build:realtime:vendor": "node scripts/copy-realtime-assets.cjs",
    "build:realtime": "npm run build:mediasoup-client && npm run build:realtime:css && npm run build:realtime:vendor"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1002.0",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.0",
    "express": "^4.22.1",
    "express-session": "^1.18.2",
    "html2canvas": "^1.4.1",
    "http": "^0.0.1-security",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "livekit-server-sdk": "^2.15.0",
    "mediasoup": "^3.19.21",
    "mediasoup-client": "^3.19.0",
    "mongoose": "^7.8.8",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.18.0",
    "pptxgenjs": "^4.0.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "tailwindcss": "^3.4.17",
    "webrtc-adapter": "^9.0.5"
  }
}
